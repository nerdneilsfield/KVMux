# CH341 direct serial backend. libusb is discovered, never downloaded or vendored.
if(APPLE)
    set(_kvmux_ch341_default ON)
else()
    set(_kvmux_ch341_default AUTO)
endif()
set(KVMUX_CH341_USB "${_kvmux_ch341_default}" CACHE STRING
    "CH341 libusb serial backend: AUTO, ON, or OFF")
set_property(CACHE KVMUX_CH341_USB PROPERTY STRINGS AUTO ON OFF)
if(NOT KVMUX_CH341_USB MATCHES "^(AUTO|ON|OFF)$")
    message(FATAL_ERROR
        "KVMUX_CH341_USB must be AUTO, ON, or OFF (got '${KVMUX_CH341_USB}')")
endif()

set(KVMUX_HAS_CH341_USB 0)
set(KVMUX_LIBUSB_DLL "")
set(KVMUX_LIBUSB_LICENSE "")

if(KVMUX_CH341_USB STREQUAL "OFF")
    message(STATUS "KVMux CH341 direct backend: disabled")
else()
    set(_kvmux_ch341_found FALSE)
    if(WIN32)
        if(NOT LIBUSB_ROOT AND DEFINED ENV{LIBUSB_ROOT})
            set(LIBUSB_ROOT "$ENV{LIBUSB_ROOT}")
        endif()
        if(LIBUSB_ROOT)
            set(_kvmux_libusb_include "")
            foreach(_dir IN ITEMS
                    "${LIBUSB_ROOT}/include/libusb-1.0"
                    "${LIBUSB_ROOT}/include")
                if(EXISTS "${_dir}/libusb.h")
                    set(_kvmux_libusb_include "${_dir}")
                    break()
                endif()
            endforeach()
            if(MSVC)
                if(CMAKE_SIZEOF_VOID_P EQUAL 8)
                    set(_kvmux_libusb_arch MS64)
                else()
                    set(_kvmux_libusb_arch MS32)
                endif()
                set(_kvmux_libusb_trees VS2022 VS2019 VS2017)
            elseif(CMAKE_SIZEOF_VOID_P EQUAL 8)
                set(_kvmux_libusb_arch "")
                set(_kvmux_libusb_trees MinGW64)
            else()
                set(_kvmux_libusb_arch "")
                set(_kvmux_libusb_trees MinGW32)
            endif()
            set(_kvmux_libusb_implib "")
            set(_kvmux_libusb_dll "")
            foreach(_tree IN LISTS _kvmux_libusb_trees)
                if(MSVC)
                    set(_dll_dir
                        "${LIBUSB_ROOT}/${_tree}/${_kvmux_libusb_arch}/dll")
                    if(EXISTS "${_dll_dir}/libusb-1.0.dll" AND
                       EXISTS "${_dll_dir}/libusb-1.0.lib")
                        set(_kvmux_libusb_dll "${_dll_dir}/libusb-1.0.dll")
                        set(_kvmux_libusb_implib "${_dll_dir}/libusb-1.0.lib")
                        break()
                    endif()
                else()
                    set(_dll_dir "${LIBUSB_ROOT}/${_tree}/dll")
                    if(EXISTS "${_dll_dir}/libusb-1.0.dll" AND
                       EXISTS "${_dll_dir}/libusb-1.0.dll.a")
                        set(_kvmux_libusb_dll "${_dll_dir}/libusb-1.0.dll")
                        set(_kvmux_libusb_implib "${_dll_dir}/libusb-1.0.dll.a")
                        break()
                    endif()
                endif()
            endforeach()
            foreach(_notice IN ITEMS COPYING COPYING.txt LICENSE LICENSE.txt)
                if(EXISTS "${LIBUSB_ROOT}/${_notice}")
                    set(KVMUX_LIBUSB_LICENSE "${LIBUSB_ROOT}/${_notice}")
                    break()
                endif()
            endforeach()
            if(_kvmux_libusb_include AND _kvmux_libusb_implib AND _kvmux_libusb_dll)
                add_library(kvmux_libusb SHARED IMPORTED GLOBAL)
                set_target_properties(kvmux_libusb PROPERTIES
                    IMPORTED_LOCATION "${_kvmux_libusb_dll}"
                    IMPORTED_IMPLIB "${_kvmux_libusb_implib}"
                    INTERFACE_INCLUDE_DIRECTORIES "${_kvmux_libusb_include}")
                set(KVMUX_LIBUSB_DLL "${_kvmux_libusb_dll}")
                set(_kvmux_ch341_found TRUE)
            endif()
        endif()
    else()
        find_package(PkgConfig QUIET)
        if(PkgConfig_FOUND)
            pkg_check_modules(KVMUX_LIBUSB QUIET IMPORTED_TARGET libusb-1.0)
        endif()
        if(KVMUX_LIBUSB_FOUND)
            set(_kvmux_ch341_found TRUE)
        endif()
    endif()

    if(_kvmux_ch341_found)
        set(KVMUX_HAS_CH341_USB 1)
        message(STATUS "KVMux CH341 direct backend: enabled")
    elseif(KVMUX_CH341_USB STREQUAL "ON")
        if(WIN32)
            message(FATAL_ERROR
                "KVMUX_CH341_USB=ON requires the official libusb Windows "
                "binaries. Set LIBUSB_ROOT to that package (include/libusb.h "
                "or include/libusb-1.0/libusb.h, libusb-1.0.dll, and its "
                "import library). KVMux does not download libusb.")
        else()
            message(FATAL_ERROR
                "KVMUX_CH341_USB=ON requires pkg-config module libusb-1.0 "
                "(headers and library). KVMux does not download libusb.")
        endif()
    else()
        message(STATUS
            "KVMux CH341 direct backend: libusb-1.0 not found; not compiled")
    endif()
endif()
